# Machine profile: everything specific to your laptop, server and network lives here, never in the repo.
# Copy to .env (gitignored) and fill in. One PORCHLIGHT_KEY=value per line, literal values (no quotes, no ~ or $VAR);
# empty means unset, and an exported variable of the same name overrides the file. Read by scripts/env.sh,
# scripts/deploy-server.sh, scripts/snapshot.sh and scripts/check-private-values.py; scripts/wt.sh copies it into
# tree copies.

# --- Laptop toolchain (scripts/env.sh); empty keeps the shell's JAVA_HOME / ANDROID_HOME
# JDK 25 for Gradle and jpackage, e.g. /usr/lib/jvm/java-25-openjdk
PORCHLIGHT_JAVA_HOME=
# e.g. /opt/android-sdk
PORCHLIGHT_ANDROID_HOME=

# --- Snapshots (scripts/snapshot.sh); empty: porchlight-snapshots next to this checkout
PORCHLIGHT_SNAPSHOT_DIR=

# --- Production server (scripts/deploy-server.sh); no defaults, commands refuse to run without them
# SSH host or ~/.ssh/config alias; its login user runs the stack and owns its directories
PORCHLIGHT_DEPLOY_HOST=
# Mount point holding the stack root (<mount>/porchlight) and incoming releases (<mount>/porchlight-dist), e.g. /srv/data
PORCHLIGHT_DEPLOY_DATA_MOUNT=
# The server's LAN address with prefix, e.g. 192.168.1.10/24: sets the enrollment peer CIDR and the certificate IP SAN
PORCHLIGHT_DEPLOY_LAN=

# --- GitHub repository to publish releases to, e.g. example-owner/porchlight
# Baked into each dist's release.json; scripts/publish-release.sh checks it against the GitHub repository.
PORCHLIGHT_RELEASE_REPO=

# --- Strings that must never appear in committed files (scripts/check-private-values.py, run by ci.sh):
# comma-separated names, usernames, hostnames. The deploy values above and your home directory are always checked.
PORCHLIGHT_PRIVATE_STRINGS=
