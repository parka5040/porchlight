# Documentation only: install.sh generates cryptographically random credentials into stack .env (0600).
# Never copy example passwords to a live stack. Root/run/project can also be supplied to install.sh.
PORCHLIGHT_ROOT=/var/lib/porchlight
PORCHLIGHT_RUN_DIR=/run/porchlight
PORCHLIGHT_VERSION=0.1.0
PORCHLIGHT_UID=1000
PORCHLIGHT_GID=1000
PG_PORT=5432
LAN_BIND=0.0.0.0
LAN_PORT=8443
ENROLL_PORT=8444
ENROLL_CIDRS=192.168.1.0/24
ENROLL_HOST=porchlight.lan
PORCHLIGHT_ENDPOINTS=https://porchlight.lan:8443
PORCHLIGHT_MIN_CLIENT_VERSION=0.1.0
BACKEND_SUBNET=172.29.250.0/24
INGRESS_SUBNET=172.29.251.0/24
FUNNEL_IP=172.29.251.10
# Installer fills POSTGRES_PASSWORD, PORCHLIGHT_{MIGRATOR,APP,AGENT,BACKUP}_PASSWORD.
