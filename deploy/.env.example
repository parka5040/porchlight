# Optional storage settings for the installed stack's .env (merge with installer-managed values).
# Distinct main/thumbnail bytes per household, including unreferenced metadata until GC: 10 GiB.
PORCHLIGHT_ATTACHMENT_QUOTA_BYTES=10737418240
# Minimum available filesystem space after staging/write/spool admission: 2 GiB.
PORCHLIGHT_DISK_RESERVE_BYTES=2147483648
