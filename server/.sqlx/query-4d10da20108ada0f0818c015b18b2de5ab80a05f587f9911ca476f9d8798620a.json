  "query": "SELECT t.id AS token_id,t.household_id,t.owner_member_id AS member_id,u.id AS user_id,u.username,t.name,t.scopes,t.expires_at,t.last_used_at FROM porchlight.api_tokens t JOIN porchlight.household_members m ON m.id=t.owner_member_id JOIN porchlight.users u ON u.id=m.user_id WHERE t.token_hash=$1 AND t.revoked_at IS NULL AND t.expires_at>now() AND m.role='super_admin' AND m.deleted_at IS NULL AND u.deleted_at IS NULL",
