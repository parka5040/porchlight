  "db_name": "PostgreSQL",
  "query": "SELECT d.id,d.member_id,d.label,d.platform,d.revoked_at,d.last_seen_at,d.created_at,(SELECT c.not_after FROM porchlight.device_certificates c WHERE c.device_id=d.id AND d.revoked_at IS NULL ORDER BY c.created_at DESC,c.id DESC LIMIT 1) AS \"certificate_expires_at?\",coalesce(d.id=$3,false) AS \"current!\",u.username AS \"username?\" FROM porchlight.devices d JOIN porchlight.household_members m ON m.id=d.member_id LEFT JOIN porchlight.users u ON u.id=m.user_id WHERE d.household_id=$1 AND ($2::uuid IS NULL OR d.member_id=$2) AND ($4::timestamptz IS NULL OR (d.created_at,d.id)>($4,$5::uuid)) ORDER BY d.created_at,d.id LIMIT $6",
